library(tidyverse)
library(zoo)
library(patchwork)
library(matrixStats)
library(ggplot2)
library(dplyr)
library(tidyr)
library(purrr)
pSS_02_087   = read.csv('../Data/pSS-02-087.csv', header = TRUE)
library(tidyverse)
library(zoo)
library(patchwork)
library(matrixStats)
library(ggplot2)
library(dplyr)
library(tidyr)
library(purrr)
pSS_02_087   = read.csv('/Data/pSS-02-087.csv', header = TRUE)
library(tidyverse)
library(zoo)
library(patchwork)
library(matrixStats)
library(ggplot2)
library(dplyr)
library(tidyr)
library(purrr)
pSS_02_087   = read.csv('Data/pSS-02-087.csv', header = TRUE)
pSS_02_075   = read.csv('Data/pSS-02-075_pSS-01-023.csv', header = TRUE)
pSS_02_087$exp_time = pSS_02_087$exp_time/60/60
pSS_02_075_1$exp_time = pSS_02_075_1$exp_time/60/60
library(tidyverse)
library(zoo)
library(patchwork)
library(matrixStats)
library(ggplot2)
library(dplyr)
library(tidyr)
library(purrr)
pSS_02_087   = read.csv('Data/pSS-02-087.csv', header = TRUE)
pSS_02_075   = read.csv('Data/pSS-02-075_pSS-01-023.csv', header = TRUE)
pSS_02_087$exp_time = pSS_02_087$exp_time/60/60
pSS_02_075$exp_time = pSS_02_075$exp_time/60/60
# Moving averages
pSS_02_087$growth_rate_ma = rollapply(pSS_02_087$growth_rate, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_087$FP1_emit1_MA21 = rollapply(pSS_02_087$FP1_emit1, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_087$FP2_emit1_MA21 = rollapply(pSS_02_087$FP2_emit1, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_087$Growth_FP1          = pSS_02_087$FP1_emit1_MA21 * pSS_02_087$growth_rate_ma
pSS_02_087$Growth_FP2          = pSS_02_087$FP2_emit1_MA21 * pSS_02_087$growth_rate_ma
pSS_02_087$Growth_FP1_ma = rollapply(pSS_02_087$Growth_FP1, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_087$Growth_FP2_ma = rollapply(pSS_02_087$Growth_FP2, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_075$growth_rate_ma = rollapply(pSS_02_075$growth_rate, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_075$FP1_emit1_MA21 = rollapply(pSS_02_075$FP1_emit1, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_075$FP2_emit1_MA21 = rollapply(pSS_02_075$FP2_emit1, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_075$Growth_FP1          = pSS_02_075$FP1_emit1_MA21 * pSS_02_075$growth_rate_ma
pSS_02_075$Growth_FP2          = pSS_02_075$FP2_emit1_MA21 * pSS_02_075$growth_rate_ma
pSS_02_075$Growth_FP1_ma = rollapply(pSS_02_075$Growth_FP1, width = 21, FUN = mean, align = "center", fill = NA)
pSS_02_075$Growth_FP2_ma = rollapply(pSS_02_075$Growth_FP2, width = 21, FUN = mean, align = "center", fill = NA)
## Plotting pSS-02-075
First_transition_row  = which(diff(pSS_02_075$Van) == 5.5)[1] + 1
First_transition_time = pSS_02_075$exp_time[First_transition_row]
Second_transition_row  = which(diff(pSS_02_075$OC6) == 50)[1] + 1
Second_transition_time = pSS_02_075$exp_time[Second_transition_row]
Third_transition_row  = which(diff(pSS_02_075$IPTG) == 1000)[1] + 1
Third_transition_time = pSS_02_075$exp_time[Third_transition_row]
factor = 0.065/0.16
p1 <- ggplot(pSS_02_075, aes(x = exp_time)) +
geom_line(aes(y = FP1_emit1_MA21, color = "GFPmut3"), linewidth = 2) +
geom_line(aes(y =  0.2857 * FP2_emit1_MA21 + 0.01929, color = "mScarlet-I"), linewidth = 2) +
# Add vertical lines and annotations as before
geom_vline(xintercept = First_transition_time, linetype = "dashed", color = "black", linewidth = 1) +
geom_vline(xintercept = Second_transition_time, linetype = "dotted", color = "black", linewidth = 1) +
geom_vline(xintercept = Third_transition_time, linetype = "twodash", color = "black", linewidth = 1) +
annotate("text", x = First_transition_time + 0.5, y = 0.063, label = "[Van]\n5.5 µM",
color = "black", size = 7, hjust = 0) +
annotate("text", x = Second_transition_time + 0.5, y = 0.063, label = "[OC6]\n50 nM",
color = "black", size = 7, hjust = 0) +
annotate("text", x = Third_transition_time + 0.5, y = 0.063, label = "[IPTG]\n1000 µM",
color = "black", size = 7, hjust = 0) +
theme_minimal() +
theme(
text = element_text(size = 20),
axis.title = element_text(size = 20, hjust = 0.5),
plot.title = element_text(size = 20, hjust = 0.5, face = "bold"),
legend.title = element_text(size = 16, hjust = 0.5),
legend.text = element_text(size = 14),
legend.position = "inside",
legend.position.inside = c(0.875, 0.875),
legend.background = element_rect(fill = "white", color = "black", linewidth = 1),
legend.key = element_rect(fill = "white", color = "white", linewidth = 1),
axis.line = element_line(linewidth = 1, color = "black"),
axis.ticks = element_line(linewidth = 1, color = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.grid = element_line(colour = "grey90", linewidth = 0.5, linetype = "dashed")
) +
scale_x_continuous(expand = c(0, 0), limits = c(7, 37), breaks = seq(7, 37, 3)) +
scale_y_continuous(
name = "GFPmut3 Fluorescence (AU)",
expand = c(0, 0),
limits = c(0.045, 0.0651),
breaks = seq(0.045, 0.065, 0.002),
sec.axis = sec_axis(~ (. - 0.01929) / 0.2857, breaks = seq(0.09, 0.16, by = 0.01), name = "mScarlet-I Fluorescence (AU)")
) +
scale_color_manual(
name = "Signal",
values = c("mScarlet-I" = "darkred", "GFPmut3" = "green")
) +
labs(
x = "Time (Hours)",
title = "pSS-02-075 + pSS-01-023 Fluorescence Timecourse in Chi.Bio"
)
print(p1)
svg("pSS-02-075.svg", width = 11.2559, height = 7.7362, bg = "white")
print(p1)
dev.off()
## Plotting pSS-02-087
First_transition_row  = which(diff(pSS_02_087$Van) == 3)[1] + 1
First_transition_time = pSS_02_087$exp_time[First_transition_row]
Second_transition_row  = which(diff(pSS_02_087$OC6) == 300)[1] + 1
Second_transition_time = pSS_02_087$exp_time[Second_transition_row]
Third_transition_row  = which(diff(pSS_02_087$IPTG) == 1000)[1] + 1
Third_transition_time = pSS_02_087$exp_time[Third_transition_row]
factor = 0.065/0.16
p2 <- ggplot(pSS_02_087, aes(x = exp_time)) +
geom_line(aes(y = FP1_emit1_MA21, color = "GFPmut3"), linewidth = 2) +
geom_line(aes(y =  0.24545 * FP2_emit1_MA21 + 0.01591, color = "mScarlet-I"), linewidth = 2) +
# Add vertical lines and annotations as before
geom_vline(xintercept = First_transition_time, linetype = "dashed", color = "black", linewidth = 1) +
geom_vline(xintercept = Second_transition_time, linetype = "dotted", color = "black", linewidth = 1) +
geom_vline(xintercept = Third_transition_time, linetype = "twodash", color = "black", linewidth = 1) +
annotate("text", x = First_transition_time + 0.5, y = 0.063, label = "[Van]\n3 µM",
color = "black", size = 7, hjust = 0) +
annotate("text", x = Second_transition_time + 0.5, y = 0.063, label = "[OC6]\n300 nM",
color = "black", size = 7, hjust = 0) +
annotate("text", x = Third_transition_time + 0.5, y = 0.063, label = "[IPTG]\n1000 µM",
color = "black", size = 7, hjust = 0) +
theme_minimal() +
theme(
text = element_text(size = 20),
axis.title = element_text(size = 20, hjust = 0.5),
plot.title = element_text(size = 20, hjust = 0.5, face = "bold"),
legend.title = element_text(size = 16, hjust = 0.5),
legend.text = element_text(size = 14),
legend.position = "inside",
legend.position.inside = c(0.875, 0.175),
legend.background = element_rect(fill = "white", color = "black", linewidth = 1),
legend.key = element_rect(fill = "white", color = "white", linewidth = 1),
axis.line = element_line(linewidth = 1, color = "black"),
axis.ticks = element_line(linewidth = 1, color = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.grid = element_line(colour = "grey90", linewidth = 0.5, linetype = "dashed")
) +
scale_x_continuous(expand = c(0, 0), limits = c(8, 38), breaks = seq(8, 38, 3)) +
scale_y_continuous(
name = "GFPmut3 Fluorescence (AU)",
expand = c(0, 0),
limits = c(0.038, 0.0651),
breaks = seq(0.038, 0.065, 0.002),
sec.axis = sec_axis(~ (. - 0.01591) / 0.24545, breaks = seq(0.09, 0.20, by = 0.01), name = "mScarlet-I Fluorescence (AU)")
) +
scale_color_manual(
name = "Signal",
values = c("mScarlet-I" = "darkred", "GFPmut3" = "green")
) +
labs(
x = "Time (Hours)",
title = "pSS-02-087 Fluorescence Timecourse in Chi.Bio"
)
print(p2)
svg("pSS-02-087.svg", width = 11.2559, height = 7.7362, bg = "white")
print(p2)
dev.off()
